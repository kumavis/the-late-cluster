# Remote state on Cloudflare R2, through Terraform's S3 backend.
#
# To use it: rename this file to backend.tf, replace the placeholders, then follow
# "Remote state on R2" in README.md (terraform init -migrate-state). Backend blocks cannot
# use variables, so the values are literal here. To keep the account id out of git, delete
# the endpoints line and export AWS_ENDPOINT_URL_S3 instead.
#
# Credentials are an R2 API token's Access Key ID and Secret Access Key, exported as
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY. Never write them in this file.

terraform {
  backend "s3" {
    bucket = "example-terraform-state"
    key    = "dns/terraform.tfstate"
    region = "auto"

    endpoints = {
      s3 = "https://ACCOUNT_ID.r2.cloudflarestorage.com"
    }

    # R2 is S3-compatible but has no STS, IAM, EC2 metadata or AWS regions, and does not
    # accept the SDK's default checksum headers.
    skip_credentials_validation = true
    skip_metadata_api_check     = true
    skip_region_validation      = true
    skip_requesting_account_id  = true
    skip_s3_checksum            = true
    use_path_style              = true

    # Lock with a .tflock object written with a conditional PUT (If-None-Match: *), which R2
    # documents as atomic. There is no DynamoDB on R2, so this is the only locking available.
    use_lockfile = true
  }
}
