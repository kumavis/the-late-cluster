# Secrets only. Copy to .secrets (ignored by git) and fill in what you need.
# Configuration that is not secret, such as the site URL and the show's Bluesky handle,
# lives in show.config.json and is committed.
#
# The root commands that need a secret load this file themselves:
#   npm run terraform -- plan
#   npm run bot -- announce 1 --live
# In GitHub Actions the same names are repository secrets.

# Cloudflare API token, scoped to DNS for the one zone. Used by Terraform.
CLOUDFLARE_API_TOKEN=

# App password for the show's Bluesky account (never the account password). Used by the bot.
BSKY_APP_PASSWORD=
