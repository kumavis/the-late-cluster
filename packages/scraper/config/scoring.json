  "builds": {
    "$comment": "Ordering of 'Built this week': a sum of weight x part. wish: the build answered someone's post; wishByOther: by someone else; sharers: log2(1 + members who shared it); engagement: ln(1 + E of build post and wish); announced: the post says it was built; ownDomain: on the builder's or a member's own domain; reactions: ln(1 + replies and quotes on the build post).",
    "weights": { "wish": 3, "wishByOther": 1, "sharers": 1.5, "engagement": 0.5, "announced": 1, "ownDomain": 1, "reactions": 0.75 },
    "max": 30
  },
  "weekDeclarations": { "maxN": 3, "top": 15 }
}
