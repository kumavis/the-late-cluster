{
  "$comment": "How posts and stories are ranked. See README 'Scoring'.",
  "engagementWeights": { "likes": 1, "reposts": 2, "quotes": 3, "replies": 1.5 },
  "baselineMinPosts": 5,
  "postWeights": { "engagement": 1, "lift": 1.2, "member": 0.5 },
