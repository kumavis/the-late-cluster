  "bioReview": {
    "$comment": "A profile description that matches one of these (or a selfDeclaredOptOut pattern) says something about quoting, keeping posts or bots: the account is marked bioReview, a note for the reviewer's repost test (R6), with the phrase that matched in private/bio-review.md. It is never excluded for it (R11). Broad on purpose.",
    "patterns": [
      "\\b(ephemeral|temporary|impermanent|transient)\\b",
      "\\b(delet(e|es|ed|ing)|disappear\\w*|vanish\\w*|wipe[sd]?|purge[sd]?)\\b",
      "\\bconsent\\b",
      "\\bpermission\\b",
      "\\b(no|not|don'?t|do not|never|without|ask|please)\\b[^.\\n]{0,25}\\b(archiv\\w*|screen ?(shot|cap)\\w*|quot\\w*|qts?|qrts?|repost\\w*|clip\\w*|scrap\\w*|unroll\\w*|train\\w*|bots?|ai|llms?)\\b",
      "\\b(detach\\w*|remov\\w*)\\s+(your\\s+|the\\s+|any\\s+)?(quote|qt)\\w*\\b",
      "\\b(train(ing)? on|training data)\\b",
