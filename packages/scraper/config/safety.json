{
  "$comment": "Safety rules from docs/bible/09-real-people.md (R7, R10, R11, R13). Patterns are case-insensitive JavaScript regexes. When in doubt, a pattern should match too much rather than too little.",
  "smallAccountFollowers": 300,
  "selfDeclaredOptOut": {
    "$comment": "R11 (the owner's ruling, 27 November 2026: anything said in public is fair game unless they explicitly asked this account not to): a profile description is addressed to everyone, not to the show, so these patterns exclude nobody. A bio matching one ('no QTs', 'AI DNI'; indirectPatterns: posts described as temporary or meant to disappear, 'not to be quoted', 'ask before you screenshot') marks the account bioReview, a note for the reviewer's repost test (R6), with the matched words in private/bio-review.md. indirectPatterns also give a post a repostNotes entry, and are read in posts by the live source check, as notes.",
    "patterns": [
      "\\b(do ?n[o']?t|don't|dont|please don't|pls don't|never|no)\\s+(qt|qrt|quote|quote[- ]?post|quote[- ]?tweet|screenshot|screen ?cap|ss|repost|rt|clip|share|archive|scrape|train on)\\w*",
      "\\b(do ?n[o']?t|don't|dont|never)\\s+use\\s+((my|these|this account'?s?)\\s+(posts|art|work|content|words|images|photos|likeness)|unroll\\w*|thread ?reader\\w*|bots?|ai|llms?)\\b",
      "\\b(do ?n[o']?t|don't|dont|no)\\s+(unroll|unroller|thread ?reader)\\w*",
      "\\bno\\s+(qts?|qrts?|quotes?|screenshots?|sses|reposts?|clips?|scraping|archiving)\\b",
      "\\bno\\s+(ai|a\\.i\\.|llms?|bots?|genai|gen ai|ml)\\b",
      "\\b(ai|bots?|llms?|scrapers?|genai)\\s*(dni|do not interact|keep out|not welcome|go away|fuck off)",
      "\\b(do not|don't|not)\\s+consent\\b",
      "\\bnot consent(ing)? to\\b",
      "\\b(no|not for|opt(ed)?[- ]?out of)\\s+(ai|llm|model|machine learning)\\s+(training|use|scraping)\\b",
      "\\bdni\\b",
      "\\bopt(ed|ing)?[- ]?out\\b",
      "\\bnoai\\b",
      "#?\\bno ?ai ?training\\b"
    ],
    "indirectPatterns": [
      "\\b(my |these |all |the )?(posts?|skeets?|tweets?|words|content|account)\\s+(are|is|will be|get|gets)\\s+(\\w+\\s+)?(temporary|ephemeral|impermanent|transient|deleted|auto[- ]?deleted|wiped|purged)\\b",
      "\\b(posts?|skeets?|tweets?|content)\\s+(are |is )?(meant|supposed|designed|intended)\\s+to\\s+(disappear|vanish|be (temporary|ephemeral|deleted|forgotten))\\b",
      "\\b(posts?|skeets?|tweets?)\\s+(disappear|vanish|self[- ]?destruct)\\w*\\b",
      "\\bi\\s+(regularly\\s+|routinely\\s+|periodically\\s+|auto[- ]?)?(delete|wipe|purge)\\s+(my|all|old)\\s+(\\w+\\s+)?(posts?|skeets?|tweets?)\\b",
      "\\b(auto[- ]?deleting|auto[- ]?delete[sd]?|self[- ]?deleting)\\b",
      "\\beverything (here )?(is|gets) (temporary|ephemeral|deleted)\\b",
      "\\bnot (to be|for being|meant to be)\\s+(quoted|screenshotted|screenshot|archived|reposted|kept|saved|scraped|used)\\b",
      "\\b(screenshots?|quotes?|qts?|quote posts?|reposts?)\\s+(are\\s+)?(not (ok|okay|allowed|welcome|cool)|forbidden|banned)\\b",
      "\\bask\\s+(me\\s+)?(before|first)(\\s+you)?\\s+(quote|qt|screenshot|share|repost|use|archive)\\w*\\b",
      "\\b(my\\s+)?(posts|words|art|work|content)\\s+(are|is)\\s+not\\s+(for|to be used (for|by))\\s+(ai|bots?|llms?|training|scraping)\\b"
    ]
