  "showOptOutPatterns": {
    "$comment": "An explicit ask to the show (R11): in a post about the show (see show.json), or addressed to its account, any of these reads as a request to be left out, and so does a consentTopics match ('don't quote me'). The author is excluded everywhere and listed for the reviewer by handle and link only.",
    "patterns": [
      "\\b(leave|keep|take|cut|edit)\\s+me\\s+out\\b",
      "\\bdon'?t\\s+(put|include|use|quote|clip|feature|show|parody|puppet)\\s+me\\b",
      "\\b(please|pls)\\s+(don'?t|do not|remove|stop)\\b",
      "\\bremove\\s+me\\b",
      "\\bnot\\s+(ok|okay|comfortable|cool)\\s+with\\b",
      "\\buncomfortable\\b",
      "\\bwithout\\s+(my\\s+)?(consent|permission)\\b",
      "\\b(didn'?t|did not|never)\\s+(consent|agree|ask)\\b",
      "\\bopt(ed|ing)?[- ]?out\\b",
      "\\bi\\s+(don'?t|do not)\\s+want\\s+to\\s+be\\b"
    ]
  },
  "showCorrectionPatterns": [
    "\\b(that'?s|that is|this is)\\s+(not|wrong|incorrect|false)\\b",
    "^\\s*(correction|to be clear|for the record)\\b",
