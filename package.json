{
  "name": "the-late-cluster",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Late Cluster: a weekly late-night talk show performed by synthesized puppet heads.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "episode:new": "node scripts/episode-new.mjs",
    "segment:new": "node scripts/segment-new.mjs",
    "dev": "node scripts/dev.mjs",
    "render": "bun packages/show/tools/render.ts",
    "check": "bun packages/show/tools/check.ts",
    "shoot": "node packages/show/tools/shoot.mjs",
    "thumbnail": "node scripts/thumbnail.mjs",
    "avatar": "node scripts/avatar.mjs",
    "build": "node scripts/build.mjs",
    "verify": "node scripts/verify.mjs",
    "site": "node packages/site/bin/build-site.mjs",
    "preview": "npm run site && node packages/site/bin/serve.mjs dist",
    "scrape": "node packages/scraper/bin/scrape.mjs",
    "lookup": "node packages/scraper/bin/lookup.mjs",
    "bot": "node --env-file-if-exists=.secrets packages/bot/bin/bot.mjs",
    "produce": "node --env-file-if-exists=.secrets packages/writers-room/bin/produce.mjs",
    "terraform": "node --env-file-if-exists=.secrets scripts/terraform.mjs",
    "test": "node --test \"scripts/test/*.test.mjs\" \"packages/*/test/**/*.test.js\" \"packages/*/test/**/*.test.mjs\""
  },
  "devDependencies": {
    "playwright": "^1.49.1",
    "vite": "^5.4.11"
  }
}
